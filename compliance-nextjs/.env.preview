# ── App URL ───────────────────────────────────────────────────────────────────
STORAGE_IMAGE_BASE_URL=/api/images/

# ── AWS S3 (disabled for preview — use local storage) ────────────────────────
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=images
SUBMISSION_TTL_DAYS=90
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── File Storage (local filesystem) ───────────────────────────────────────────
STORAGE_IMAGE_PATH=./data/images
STORAGE_JSON_PATH=./data/submissions.json
STORAGE_JSON_ADMIN_PATH=./data/admins.json
EXCEL_UPDATE_PATH=./data/tracking.xlsx

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://preview:preview@mongo:27017/compliance?authSource=admin

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=preview-secret-change-in-production-256bits!!
JWT_EXPIRY_HOURS=1

# ── AI Providers (disabled for preview — no API keys) ────────────────────────
AI_GEMINI_ENABLED=false
AI_GEMINI_ORDER=0
GEMINI_API_KEY=
AI_GEMINI_ENDPOINT=https://aiportalapi.stu-platform.live/jpe
AI_GEMINI_MODEL=Gemini-3.1-Flash-Lite

AI_CHATGPT_ENABLED=false
AI_CHATGPT_ORDER=1
CHATGPT_API_KEY=
AI_CHATGPT_ENDPOINT=https://aiportalapi.stu-platform.live/use
CHATGPT_MODEL=GPT-5-mini

AI_NVIDIA_ENABLED=false
AI_NVIDIA_ORDER=2
NVIDIA_API_KEY=
AI_NVIDIA_ENDPOINT=
AI_NVIDIA_MODEL=

# ── Notifications ─────────────────────────────────────────────────────────────
NOTIFICATION_MODE=teams
TEAMS_WEBHOOK_URL=
DEADLINE_DATE=
REMINDER_DAYS_BEFORE=7
NOTIFICATION_MESSAGE=Please submit your compliance documents before the deadline.

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPM=20

# ── Attendance API ────────────────────────────────────────────────────────────
ATTENDANCE_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
